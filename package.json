{
  "name": "job-search-automation",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/server/queue/workers.ts",
    "schedule": "tsx scripts/schedule.ts",
    "apply:assist": "tsx scripts/apply-assist.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bullmq": "5.34.3",
    "next": "14.2.21",
    "playwright": "1.49.1",
    "pino": "9.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.21",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
